  "view": {
    "subtitle": "THE ANCHOR-WIELDING SPACE ADMIRAL",
    "intro": "An iron-clad admiral with a trusty anchor and a taste for tea. Hook into the action, tether an enemy to Homboldt, and let your crew finish the job.",
    "briefing": "Swiggins excels with backup. Check enemy crowd control before hooking in, then coordinate a tether with nearby allies.",
    "abilities_intro": "Homboldt changes how Swiggins fights. Carry the anchor for melee attacks and Anchor Hook; drop it to tether an enemy and switch to Ink Spray.",
    "tactics": [
      {
        "title": "Playing as Swiggins",
        "text": "Anchor Hook commits you to close range. Check your team's position before diving. Recover Homboldt after dropping it to regain Anchor Swing and access to Anchor Hook."
      },
      {
        "title": "Playing with Swiggins",
        "text": "Stay nearby and follow up when he catches an enemy. Protect the anchor when it is safe to help him retrieve it."
      },
      {
        "title": "Playing against Swiggins",
        "text": "Destroying Homboldt can free a tethered target. Traps and crowd control can punish his approach; without his anchor, his damage potential drops."
      }
    ],
    "story": [
      {
        "tag": "h2",
        "text": "FROM TITAN TO THE STARS"
      },
      {
        "tag": "p",
        "text": "Charles Swiggins grew up on Titan as the youngest of thirty siblings in a naval family. After graduating from Wet Point, he took command of the Royal Fleet's Sweet Homboldt."
      },
      {
        "tag": "p",
        "text": "His encounter with Captain Inkbeard's Colossus left both ships wrecked. In the final fight, Swiggins seized his ship's anchor and used it to defeat the pirate captain."
      },
      {
        "tag": "p",
        "text": "Now an admiral, he carries Homboldt into space as a member of the Awesomenauts."
      },
      {
        "tag": "h3",
        "text": "A NAUT MADE BY THE COMMUNITY"
      },
      {
        "tag": "p",
        "text": "Swiggins originated in the 2012 Design-Your-Naut contest. Channfree created the winning concept; Coffeybean4 won the subsequent visual design contest."
      }
    ],
    "story_facts": [
